#!/usr/bin/env bash
# Translates Claude Code CLI flags (Paperclip claude_local protocol) to qodercli.
# QODER_CLI_PATH overrides binary resolution; otherwise qodercli is taken from PATH.
set -eu
QODER_BIN="${QODER_CLI_PATH:-$(command -v qodercli || true)}"
if [ -z "$QODER_BIN" ]; then
  echo "qodercli not found. Install Qoder CLI or set QODER_CLI_PATH." >&2
  exit 127
fi
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --append-system-prompt-file)
      args+=(--append-system-prompt "$(cat "$2")")
      shift 2 ;;
    --effort)
      args+=(--reasoning-effort "$2")
      shift 2 ;;
    --verbose|--chrome)
      shift ;;
    --max-turns)
      shift 2 ;;
    *)
      args+=("$1")
      shift ;;
  esac
done
exec "$QODER_BIN" "${args[@]}"